+def test_m1_underscore_glued_name_resolves_instead_of_leaking() -> None:
+    """m1 (review3): `_` used to count as a word character, so
+    'anil_sharma_loans' was ONE glued span that never matched 'anil sharma'
+    as a whole and leaked both name components in clear. Now `_` is a
+    separator (like '-'), so the two name words are found as separate
+    spans; `EntityResolver._normalize` already folds '_' to a space, so the
+    2-word window's raw text ("anil_sharma") still resolves exact."""
+    tm = TokenMap(_resolver(borrower_name=["anil sharma"]))
+
+    result = tm.tokenise_prompt("anil_sharma_loans")
+
+    assert result == "B001_loans"
+

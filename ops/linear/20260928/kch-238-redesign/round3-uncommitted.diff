+def _random_2000_char_prompt() -> str:
+    """The reviewer's OWN word list (a3.py/a4.py), verbatim -- real DEMO
+    name/vocabulary words mixed with ordinary English, so this is the exact
+    adversarial corpus review3's F3 measurements were taken against."""
+    words = [
+        "show", "me", "the", "overdue", "loans", "for", "anil", "sharma", "and",
+        "meera", "iyer", "lent", "45,000/-", "2 lakh", "in", "2026", "ref",
+        "2026_03_004", "b1,b2", "bg10/bg13", "sharma-ji", "o'brien", "what", "is",
+        "exposure?", "12%", "3", "months", "Q2", "iyer chem", "gupta & sons",
+        "naveen", "rao's", "mumbai", "desk", "rs 500", "please", "total",
+    ]
+    random.seed(1)
+    parts: list[str] = []
+    while len(" ".join(parts)) < 2000:
+        parts.append(random.choice(words))
+    return " ".join(parts)[:2000]
+

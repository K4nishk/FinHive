+def _demo_resolver() -> EntityResolver:
+    """The real DEMO fixture's ~75-name universe (review3's own "DEMO
+    universe"), not a synthetic stand-in -- F3's measurements are only
+    meaningful against the actual resolver KCH-239 will construct."""
+    from loan_manager.application.use_cases.loans.build_entity_resolver import (
+        BuildEntityResolver,
+    )
+    from loan_manager.application.use_cases.loans.get_autocomplete import (
+        GetAutocompleteValues,
+    )
+    from loan_manager.infrastructure.seed.demo_fixture import DEMO_LOANS
+
+    loans = [
+        make_loan(
+            borrower_name=fl.borrower_name,
+            borrower_group=fl.borrower_group,
+            depositor_name=fl.depositor_name,
+            depositor_group=fl.depositor_group,

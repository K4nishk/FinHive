# Application Settings
APP_NAME=LoanTracker
APP_VERSION=1.0.0
ENVIRONMENT=production

# Storage Configuration
# Options: csv, sqlite
STORAGE_TYPE=csv

# Encryption Configuration
# Leave empty to disable encryption
ENCRYPTION_KEY=

# CSV Storage Settings (when STORAGE_TYPE=csv)
CSV_OUTPUT_DIR=./engine_output
CSV_FILENAME=loan_records.csv

# SQLite Storage Settings (when STORAGE_TYPE=sqlite)
SQLITE_DB_PATH=./engine_output/loantracker.db

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/loantracker.log
